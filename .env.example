# ============================================================================
# NexusAI 环境配置
# ============================================================================
# 复制此文件为 .env 并填入实际值:
#   cp .env.example .env
#
# 服务启动时自动加载项目根目录下的 .env 文件。
# ============================================================================

# --- LLM / AI 模型 ---
# DeepSeek API 密钥，从 https://platform.deepseek.com 获取
LLM_API_KEY=sk-your-api-key-here
# 模型名称，如 deepseek-v4-flash（快速）或 deepseek-v4-pro（更强）
LLM_MODEL=deepseek-v4-flash
# LLM API 完整端点地址（OpenAI 兼容格式，直接作为 completions endpoint 使用）
LLM_API_URL=https://api.deepseek.com/v1/chat/completions
EMBEDDING_API_URL=https://api.deepseek.com/v1/embeddings
EMBEDDING_MODEL=deepseek-v4-pro

# --- 服务端口 ---
RPC_SERVER_PORT=50051
ORCHESTRATOR_PORT=5000
REGISTRY_PORT=8500

# --- 服务地址 ---
ORCHESTRATOR_URL=http://localhost:5000
REGISTRY_URL=http://localhost:8500

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# --- 路由调优 ---
ROUTING_HIGH_THRESHOLD=0.85
ROUTING_LOW_THRESHOLD=0.50

# P7 (批次十一): Embedding 路由层开关——默认开启（缺省 1），仅显式 =0 才关。
# 向量基建已并入默认构建（agent_rpc_common），无需 -DENABLE_MCP；装配失败
# （API key/URL 缺失或服务不可用）自动静默降级回 LLM/关键词三层管线。
NEXUSAI_EMBEDDING_ROUTER=1

# P1/P2/P3: 记忆回路开关（默认开）。NEXUSAI_MEMORY_HINTS_RECALL 控制查询时
# Redis hints/摘要回读（关闭则仅用 PG 会话窗口）；NEXUSAI_CROSS_AGENT_SUMMARY
# 控制跨 Agent 摘要生成（关闭则 last_agent 照常记录、仅跳过摘要 LLM 调用）。
# 两者均为逐请求热读，无需重启。
NEXUSAI_MEMORY_HINTS_RECALL=1
NEXUSAI_CROSS_AGENT_SUMMARY=1

# P8: 路由层负载均衡开关（默认关闭=现状逻辑逐字节不变）。设置后多 Agent 候选选择
# 经由 common 负载均衡器决策，可选值：
#   round_robin | random | weighted_round_robin | consistent_hash | shortest_response
# （P8 S3: shortest_response 已开放——EMA 平滑延迟由成功调用喂数通道提供，α=0.1
# 与健康评估同值；least_connections 无请求完成释放钩子仍未开放。）
# 注意：此开关为进程级一次性读取（首个路由请求时生效），改环境变量需重启；
# 其余逐请求热读的开关不在此列。非法值会记日志并保持关闭。健康过滤在候选
# 构建期已完成，负载均衡只在健康候选内决策。
# NEXUSAI_ROUTER_LB_STRATEGY=round_robin

# P10: 单意图快速路径开关（默认关闭）。设为 1 时，对 Embedding 层高置信命中（相似度≥
# high_threshold）且无多意图信号（并列/序列词、编号列表、and then 等，宁严勿松）的查询，
# 跳过规划 LLM 直接构造单 Agent 计划；执行失败（Agent 报错/不可达）回退全量规划重试一次。
# 依赖 Embedding 层：需 -DENABLE_MCP=ON 构建 + NEXUSAI_EMBEDDING_ROUTER=1 才会真正命中。
NEXUSAI_SINGLE_INTENT_FAST_PATH=0

# --- 超时（秒） ---
REQUEST_TIMEOUT=60
LLM_TIMEOUT=30
A2A_TIMEOUT=30

# --- 日志 ---
# --- Docker Compose / WSL2 platform path ---
# Compose supplies these values to PostgreSQL and uses service DNS internally.
POSTGRES_DB=nexusai
POSTGRES_USER=nexusai
POSTGRES_PASSWORD=nexusai-dev-password

# Local Node proxy defaults. Docker Compose sets GRPC_TARGET=rpc-server:50051.
PROXY_PORT=8081
GRPC_TARGET=localhost:50051

# Local browser entrypoint (plain HTTP; no development certificates are required).
FRONTEND_URL=http://127.0.0.1:8080

# MCP/RAG is an opt-in CMake module, not part of the default build.
ENABLE_MCP=OFF

# --- 管理员账号（PR-C3） ---
# Agent 注册/注销等管理面 RPC 仅允许该用户名获得 ADMIN role（注册时匹配）。
# 留空则没有任何用户具备 ADMIN，RegisterAgent/UnregisterAgent 将被拒绝。
NEXUSAI_ADMIN_USERNAME=

# --- Trusted proxy（P26 T3，默认关闭；网关与后端两处同读） ---
# 设为 1 时：Node 代理在转发前本地代查会话（deny/epoch/session 键，miss 回源
# ValidateToken），消费 Bearer 并注入 HMAC 签名的 x-nexusai-* 身份头；后端拦截器
# 验签免查 PG（无签名头时仍兼容旧 Bearer 路径——双校验过渡）。
# 共享密钥两进程必须一致且 >= 32 字符；trust=1 而密钥缺失/过短时两端都会拒启动。
# 未开启（默认）时行为与历史逐字节一致（Bearer 透传、后端认证）。
# NEXUSAI_TRUST_PROXY=1
# NEXUSAI_PROXY_HMAC_SECRET=change-me-to-a-long-random-secret

# --- Token 预算（PR-C2 durable pipeline；budgetLimitsFromEnvironment 默认值） ---
# 四层预算，token 数均为估算值（64 + question.size()/4），超限的查询
# 返回 RESOURCE_EXHAUSTED 并在 query_logs 落库 status=rejected。
# 0 表示不限制该层预算。
NEXUSAI_BUDGET_GLOBAL_TOKENS=0
NEXUSAI_BUDGET_USER_DAILY_TOKENS=200000
NEXUSAI_BUDGET_USER_MONTHLY_TOKENS=4000000
NEXUSAI_BUDGET_SESSION_TOKENS=100000

LOG_LEVEL=INFO

# This development password is local-only; production must inject a managed secret.
# PostgresStore/db_migrate read only these names (Compose maps them to service DNS).
NEXUSAI_POSTGRES_HOST=127.0.0.1
NEXUSAI_POSTGRES_PORT=5432
NEXUSAI_POSTGRES_DATABASE=nexusai
NEXUSAI_POSTGRES_USER=nexusai
NEXUSAI_POSTGRES_PASSWORD=nexusai-dev-password

# The POSTGRES_* names above are consumed by Compose's postgres service.
